{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM2PCG GeneratedWorld v2",
  "description": "Full Core output. Cross-field mask lengths, typed placement rules and request correspondence are checked by decodeSpatialWorld; format v1 remains separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "worldType",
    "generatorVersion",
    "width",
    "height",
    "seed",
    "elevationUnits",
    "waterMask",
    "routeMask",
    "bridgeMask",
    "protectedMask",
    "startIndex",
    "exitIndex",
    "featureMasks",
    "placements",
    "placementDiagnostics",
    "constraints",
    "worldHash",
    "semanticHash"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 2
    },
    "worldType": {
      "type": "string",
      "enum": [
        "Forest",
        "Desert",
        "Snowfield",
        "Swamp"
      ]
    },
    "generatorVersion": {
      "type": "string",
      "enum": [
        "forest-biome@2",
        "desert-biome@2",
        "snowfield-biome@2",
        "swamp-biome@2"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 16,
      "maximum": 500
    },
    "height": {
      "type": "integer",
      "minimum": 16,
      "maximum": 500
    },
    "seed": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "elevationUnits": {
      "type": "array",
      "minItems": 256,
      "maxItems": 250000,
      "items": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      }
    },
    "waterMask": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 333336,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "routeMask": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 333336,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "bridgeMask": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 333336,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "protectedMask": {
      "type": "string",
      "contentEncoding": "base64",
      "maxLength": 333336,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "startIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 249999
    },
    "exitIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 249999
    },
    "featureMasks": {
      "type": "object",
      "properties": {},
      "maxProperties": 3,
      "additionalProperties": {
        "type": "string",
        "contentEncoding": "base64",
        "maxLength": 333336,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      }
    },
    "placements": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "type",
          "stableId",
          "x",
          "y",
          "elevationUnits",
          "yawDegrees",
          "scalePermille"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "trees",
              "rocks",
              "bushes",
              "groundDetails",
              "waterProps"
            ]
          },
          "type": {
            "type": "string"
          },
          "stableId": {
            "type": "string",
            "pattern": "^(trees|rocks|bushes|groundDetails|waterProps):[0-9]+:[0-9]+$"
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 499
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 499
          },
          "elevationUnits": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "yawDegrees": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "scalePermille": {
            "type": "integer",
            "minimum": 850,
            "maximum": 1150
          }
        }
      }
    },
    "placementDiagnostics": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "code",
          "candidateCount",
          "eligibleCount",
          "selectedCount",
          "placedCount",
          "rejected",
          "renderedCount"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "trees",
              "rocks",
              "bushes",
              "groundDetails",
              "waterProps"
            ]
          },
          "code": {
            "type": "string"
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "eligibleCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "selectedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "placedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "rejected": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250000
            }
          },
          "renderedCount": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 250000
              }
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "cellCount",
          "borderContacts",
          "centerContacts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "passed"
          },
          "cellCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          },
          "borderContacts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "centerContacts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 250000
          }
        }
      }
    },
    "worldHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semanticHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
